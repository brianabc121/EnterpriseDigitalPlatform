        {
          "expr": "sum by (tenant) (increase(edp_sessions_closed_total{served_by=\"ai\",tenant=~\"$tenant\"}[1h])) / clamp_min(sum by (tenant) (increase(edp_sessions_closed_total{served_by=\"ai\",tenant=~\"$tenant\"}[1h])) + sum by (tenant) (increase(edp_ai_handoffs_total{tenant=~\"$tenant\"}[1h])), 1) * on (tenant) group_left (code) max by (tenant, code) (edp_tenant_info)",
