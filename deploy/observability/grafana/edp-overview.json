      "targets": [
        {
          "expr": "sum by (tenant) (edp_human_sessions{tenant=~\"$tenant\"}) / clamp_min(sum by (tenant) (edp_agent_capacity{tenant=~\"$tenant\"}), 1) * on (tenant) group_left (code) max by (tenant, code) (edp_tenant_info)",
          "legendFormat": "{{code}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
