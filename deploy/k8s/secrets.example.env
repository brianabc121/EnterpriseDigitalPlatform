# Secret edp-secrets 的内容示例（不要提交真实值）。创建：
#   kubectl -n edp create secret generic edp-secrets --from-env-file=secrets.env
# 生产环境（EDP_ENV=prod）启动时会检查这些密钥不是开发默认值。
EDP_DATABASE_URL_APP=postgresql+asyncpg://edp_app:CHANGE_ME@pg.example.internal:5432/edp
EDP_DATABASE_URL_PLATFORM=postgresql+asyncpg://edp_platform:CHANGE_ME@pg.example.internal:5432/edp
EDP_DATABASE_URL_OWNER=postgresql+asyncpg://edp_owner:CHANGE_ME@pg.example.internal:5432/edp
EDP_REDIS_URL=redis://:CHANGE_ME@redis.example.internal:6379/0
EDP_JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
EDP_PLATFORM_JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
EDP_VISITOR_JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
EDP_FILE_URL_SECRET=CHANGE_ME_64_RANDOM_CHARS
EDP_DATA_ENCRYPTION_KEY=CHANGE_ME_64_RANDOM_CHARS
# 接口传输加密的签名私钥：python -m app.cli transport-keygen 生成（同时输出前端用的公钥）。
EDP_TRANSPORT_SIGNING_KEY=CHANGE_ME_BASE64_FROM_TRANSPORT_KEYGEN
EDP_OPENIM_SECRET=CHANGE_ME
EDP_OPENIM_WEBHOOK_SECRET=CHANGE_ME
EDP_STORAGE_ACCESS_KEY=CHANGE_ME
EDP_STORAGE_SECRET_KEY=CHANGE_ME
# 企业微信服务商（不接入企业微信时删除这几行）。
EDP_WECOM_SUITE_ID=CHANGE_ME
EDP_WECOM_SUITE_SECRET=CHANGE_ME
EDP_WECOM_TOKEN=CHANGE_ME
EDP_WECOM_ENCODING_AES_KEY=CHANGE_ME_43_CHARS
# 大模型（也可以在运营后台配置供应商，这里留空）。
EDP_LLM_PROVIDER=
EDP_LLM_BASE_URL=
EDP_LLM_API_KEY=
EDP_LLM_CHAT_MODEL=
