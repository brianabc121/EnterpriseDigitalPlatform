# 浏览器验收（CI 与本地）使用的后端配置：数据库、Redis、对象存储用 deploy/compose 的开发环境，
# 大模型、语音转文字、企业微信、邮箱和病毒扫描都接到仓库里的模拟服务。这里只有开发用的假值。
EDP_LLM_PROVIDER=fake
EDP_LLM_BASE_URL=http://127.0.0.1:8900/v1
EDP_LLM_API_KEY=dev-key
EDP_LLM_CHAT_MODEL=fake-chat
EDP_LLM_EMBED_MODEL=fake-embed
EDP_ASR_BASE_URL=http://127.0.0.1:8900/v1
EDP_ASR_MODEL=fake-asr
# 服务商凭证要和模拟企业微信（tests/fake_wecom.py 的 SUITE_ID、SUITE_SECRET、TOKEN、AES_KEY）一致，
# 否则回调验签失败、收不到 suite_ticket（tests/test_e2e_env.py 检查）。
EDP_WECOM_SUITE_ID=wwsuitefake0001
EDP_WECOM_SUITE_SECRET=fake-suite-secret
EDP_WECOM_TOKEN=fakeCallbackToken
EDP_WECOM_ENCODING_AES_KEY=6XHlddOG9GFXaALethHWtsAVb8E6FKtY0cIHMNwAzx0
EDP_WECOM_API_URL=http://127.0.0.1:8901
EDP_WECOM_INSTALL_URL=http://127.0.0.1:8901/3rdapp/install
EDP_WECOM_OAUTH_URL=http://127.0.0.1:8901/connect/oauth2/authorize
EDP_WECOM_SSO_URL=http://127.0.0.1:8901/wwlogin/sso/login
EDP_CONSOLE_PUBLIC_URL=http://localhost:5173
EDP_CLAMAV_HOST=127.0.0.1
EDP_CLAMAV_PORT=3310
# 模拟邮箱服务器在本机、不加密（tests/fake_mail.py）：放开内网地址和不加密的连接，只用于测试。
EDP_MAIL_ALLOW_PRIVATE_HOSTS=true
