# 复制为 .env 后按需修改。默认值适用于 `make dev-up` 和 `make im-up` 起的本地环境。
EDP_ENV=dev
EDP_DATABASE_URL_APP=postgresql+asyncpg://edp_app:edp_app@localhost:5432/edp
EDP_DATABASE_URL_PLATFORM=postgresql+asyncpg://edp_platform:edp_platform@localhost:5432/edp
EDP_DATABASE_URL_OWNER=postgresql+asyncpg://postgres:postgres@localhost:5432/edp
EDP_REDIS_URL=redis://localhost:6379/0

# OpenIM：后端调用 REST 的地址，以及浏览器（SDK）访问的公开地址。
EDP_OPENIM_API_URL=http://localhost:10002
EDP_OPENIM_PUBLIC_API_URL=http://localhost:10002
EDP_OPENIM_PUBLIC_WS_URL=ws://localhost:10001

# 平台运营账号的二次验证（TOTP）：不设置时生产环境强制启用，其他环境可选。
# EDP_PLATFORM_MFA_REQUIRED=true

# 生产环境必须设置为足够长的随机字符串，并开启 EDP_COOKIE_SECURE。
# OpenIM 的两个密钥要与 OpenIM 部署一致（share.yml 的 secret；webhooks.yml 回调地址中的路径密钥）。
# EDP_JWT_SECRET=
# EDP_PLATFORM_JWT_SECRET=
# EDP_VISITOR_JWT_SECRET=
# EDP_OPENIM_SECRET=
# EDP_OPENIM_WEBHOOK_SECRET=
# EDP_COOKIE_SECURE=true

# 对象存储（S3 兼容）：后端访问地址与签发给浏览器的公开地址。bucket 为空时使用虚拟主机风格
# （https://<bucket>.<endpoint>），否则为路径风格（https://<endpoint>/<bucket>）。
EDP_STORAGE_ENDPOINT=http://localhost:9000
EDP_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
EDP_STORAGE_ACCESS_KEY=edp
EDP_STORAGE_BUCKET=edp-files
# 平台对外地址（文件链接）和 Widget 地址（Widget 自己的页面总是允许接入）。
EDP_PUBLIC_API_URL=http://localhost:8000
EDP_WIDGET_PUBLIC_URL=http://localhost:5175
# 生产环境必须设置：
# EDP_STORAGE_SECRET_KEY=
# EDP_FILE_URL_SECRET=

# 大模型（OpenAI 兼容协议：DeepSeek、通义千问、智谱、豆包、Kimi、自建 vLLM 等）。
# 运营后台"模型供应商"里配置了默认供应商后以那里为准；这里的配置在没有配置供应商时使用。
# EDP_LLM_BASE_URL 为空时不启用 AI 接待和坐席助手；向量模型为空时知识库只用关键词检索。
# 本地联调可以用模拟服务：cd backend && uv run python -m tests.fake_llm --port 8900
# EDP_LLM_PROVIDER=deepseek
# EDP_LLM_BASE_URL=https://api.deepseek.com/v1
# EDP_LLM_API_KEY=
# EDP_LLM_CHAT_MODEL=deepseek-chat
# EDP_LLM_FAST_MODEL=
# 主模型不可用时的备用模型（可选）：
# EDP_LLM_FALLBACK_PROVIDER=qwen
# EDP_LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EDP_LLM_FALLBACK_API_KEY=
# EDP_LLM_FALLBACK_CHAT_MODEL=qwen-plus
# 向量模型（维度须为 1024；地址和密钥为空时沿用上面的主模型配置）：
# EDP_LLM_EMBED_BASE_URL=
# EDP_LLM_EMBED_API_KEY=
# EDP_LLM_EMBED_MODEL=text-embedding-v3
# EDP_LLM_EMBED_SEND_DIMENSIONS=true

# 语音转文字（OpenAI 兼容的 /audio/transcriptions）：客户发来的语音转写成文字，AI 据此理解。为空时不转写。
# EDP_ASR_BASE_URL=https://api.siliconflow.cn/v1
# EDP_ASR_API_KEY=
# EDP_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# 微信客服的 AMR 语音转成 MP3 供网页播放（没有 ffmpeg 时保留原文件，工作台提供下载）：
# EDP_FFMPEG_PATH=ffmpeg

# 渠道凭证（企业微信永久授权码等）的加密密钥，生产环境必须设置为随机字符串：
# EDP_DATA_ENCRYPTION_KEY=

# 企业微信服务商（代开发应用）。EDP_WECOM_SUITE_ID 为空时不启用企业微信接入。
# 在服务商后台创建代开发应用模板后填写模板 ID 与 Secret；回调 Token 与 EncodingAESKey 需要与模板、
# 以及为每个企业上线的代开发应用的回调配置一致。回调地址：
#   指令回调 {EDP_PUBLIC_API_URL}/hooks/wecom/cmd，数据回调 {EDP_PUBLIC_API_URL}/hooks/wecom/data
# EDP_WECOM_SUITE_ID=
# EDP_WECOM_SUITE_SECRET=
# EDP_WECOM_TOKEN=
# EDP_WECOM_ENCODING_AES_KEY=
# 员工控制台的对外地址：授权完成、扫码登录后跳回这里，应用消息里的链接也指向这里。
# EDP_CONSOLE_PUBLIC_URL=http://localhost:5173
# 本地联调可以用模拟服务：cd backend && uv run python -m tests.fake_wecom --port 8901
# 并把下面四个地址指向它（模拟服务的模板 ID、Secret、Token、EncodingAESKey 见 tests/fake_wecom.py）：
# EDP_WECOM_API_URL=http://127.0.0.1:8901
# EDP_WECOM_INSTALL_URL=http://127.0.0.1:8901/3rdapp/install
# EDP_WECOM_OAUTH_URL=http://127.0.0.1:8901/connect/oauth2/authorize
# EDP_WECOM_SSO_URL=http://127.0.0.1:8901/wwlogin/sso/login
